<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed for the provider to verify that the caller is SystemUI. -->
    <queries>
        <package android:name="com.android.systemui" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_app"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FodCustomizer"
        android:usesCleartextTraffic="false">

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposeddescription" android:value="@string/xposed_description" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Only the module and the SystemUI UID may read these private files;
             OverridesProvider checks the Binder caller for every read. -->
        <provider
            android:name=".OverridesProvider"
            android:authorities="${applicationId}.overrides"
            android:directBootAware="true"
            android:exported="true"
            android:grantUriPermissions="false" />
    </application>
</manifest>
